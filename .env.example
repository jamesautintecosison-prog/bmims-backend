# Owner connection: used ONLY to run migration scripts, never by the app
MIGRATION_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Restricted role connections used by the API server, one per tier
ADMIN_DATABASE_URL=postgresql://admin_role:PASSWORD@HOST/DBNAME?sslmode=require
STAFF_DATABASE_URL=postgresql://staff_role:PASSWORD@HOST/DBNAME?sslmode=require
RESIDENT_DATABASE_URL=postgresql://resident_role:PASSWORD@HOST/DBNAME?sslmode=require

# Login-lookup role (can only SELECT from users) and token settings
AUTH_DATABASE_URL=postgresql://auth_role:PASSWORD@HOST/DBNAME?sslmode=require
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1h