generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_logs {
  audit_id           BigInt   @id @default(autoincrement())
  changed_by_user_id Int?
  table_name         String   @db.VarChar(63)
  record_id          Int
  action_type        String   @db.VarChar(10)
  old_value          Json?
  new_value          Json?
  logged_at          DateTime @default(now()) @db.Timestamptz(6)
  users              users?   @relation(fields: [changed_by_user_id], references: [user_id])

  @@index([logged_at], map: "idx_audit_logged_at")
  @@index([table_name, record_id], map: "idx_audit_table_record")
  @@index([changed_by_user_id], map: "idx_audit_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model committee_budgets {
  budget_id        Int            @id @default(autoincrement())
  committee_id     Int
  fiscal_year      String         @db.VarChar(4)
  allocated_amount Decimal        @db.Decimal(14, 2)
  remaining_amount Decimal        @db.Decimal(14, 2)
  committees       committees     @relation(fields: [committee_id], references: [committee_id])
  expense_logs     expense_logs[]

  @@unique([committee_id, fiscal_year], map: "uq_budget_committee_year")
}

model committees {
  committee_id                Int                           @id @default(autoincrement())
  committee_name              String                        @unique @db.VarChar(100)
  description                 String?
  committee_budgets           committee_budgets[]
  health_programs             health_programs[]
  incident_reports            incident_reports[]
  service_requests            service_requests[]
  staff_committee_assignments staff_committee_assignments[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model document_types {
  doc_type_id      Int                @id @default(autoincrement())
  name             String             @unique @db.VarChar(100)
  description      String?
  fee_amount       Decimal            @default(0) @db.Decimal(10, 2)
  service_requests service_requests[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model expense_logs {
  expense_id           Int               @id @default(autoincrement())
  budget_id            Int
  approved_by_staff_id Int
  description          String
  amount               Decimal           @db.Decimal(14, 2)
  date_incurred        DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  staff                staff             @relation(fields: [approved_by_staff_id], references: [staff_id])
  committee_budgets    committee_budgets @relation(fields: [budget_id], references: [budget_id])

  @@index([budget_id], map: "idx_expenses_budget")
  @@index([date_incurred], map: "idx_expenses_date")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model health_programs {
  program_id                  Int                           @id @default(autoincrement())
  committee_id                Int
  program_name                String                        @db.VarChar(120)
  description                 String?
  start_date                  DateTime                      @db.Date
  end_date                    DateTime?                     @db.Date
  committees                  committees                    @relation(fields: [committee_id], references: [committee_id])
  resident_program_enrollment resident_program_enrollment[]

  @@unique([committee_id, program_name], map: "uq_program_per_committee")
  @@index([committee_id], map: "idx_programs_committee")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model households {
  household_id                                     Int         @id @default(autoincrement())
  head_resident_id                                 Int?
  address                                          String      @db.VarChar(255)
  date_registered                                  DateTime    @default(dbgenerated("CURRENT_DATE")) @db.Date
  residents_households_head_resident_idToresidents residents?  @relation("households_head_resident_idToresidents", fields: [head_resident_id], references: [resident_id], map: "fk_households_head_resident")
  residents_residents_household_idTohouseholds     residents[] @relation("residents_household_idTohouseholds")

  @@index([head_resident_id], map: "idx_households_head")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model incident_participants {
  participant_id   Int              @id @default(autoincrement())
  incident_id      Int
  resident_id      Int
  participant_role String           @db.VarChar(20)
  statement        String?
  incident_reports incident_reports @relation(fields: [incident_id], references: [incident_id], onDelete: Cascade)
  residents        residents        @relation(fields: [resident_id], references: [resident_id])

  @@unique([incident_id, resident_id, participant_role], map: "uq_incident_resident_role")
  @@index([resident_id], map: "idx_participants_resident")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model incident_reports {
  incident_id           Int                     @id @default(autoincrement())
  committee_id          Int
  handled_by_staff_id   Int?
  date_filed            DateTime                @default(now()) @db.Timestamptz(6)
  location              String                  @db.VarChar(255)
  description           String
  status                String                  @default("Open") @db.VarChar(25)
  incident_participants incident_participants[]
  committees            committees              @relation(fields: [committee_id], references: [committee_id])
  staff                 staff?                  @relation(fields: [handled_by_staff_id], references: [staff_id], onDelete: Restrict)

  @@index([committee_id], map: "idx_incidents_committee")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model resident_program_enrollment {
  enrollment_id   Int             @id @default(autoincrement())
  resident_id     Int
  program_id      Int
  enrollment_date DateTime        @default(dbgenerated("CURRENT_DATE")) @db.Date
  status          String          @default("Enrolled") @db.VarChar(20)
  health_programs health_programs @relation(fields: [program_id], references: [program_id])
  residents       residents       @relation(fields: [resident_id], references: [resident_id])

  @@unique([resident_id, program_id], map: "uq_resident_program")
  @@index([program_id], map: "idx_enrollment_program")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model residents {
  resident_id                                       Int                           @id @default(autoincrement())
  household_id                                      Int?
  first_name                                        String                        @db.VarChar(60)
  last_name                                         String                        @db.VarChar(60)
  birth_date                                        DateTime                      @db.Date
  gender                                            String                        @db.VarChar(10)
  contact_number                                    String?                       @db.VarChar(20)
  resident_status                                   String                        @default("Active") @db.VarChar(20)
  households_households_head_resident_idToresidents households[]                  @relation("households_head_resident_idToresidents")
  incident_participants                             incident_participants[]
  resident_program_enrollment                       resident_program_enrollment[]
  households_residents_household_idTohouseholds     households?                   @relation("residents_household_idTohouseholds", fields: [household_id], references: [household_id])
  service_requests                                  service_requests[]
  users                                             users?

  @@index([household_id], map: "idx_residents_household")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model service_requests {
  request_id         Int            @id @default(autoincrement())
  resident_id        Int
  doc_type_id        Int
  committee_id       Int
  issued_by_staff_id Int?
  status             String         @default("Pending") @db.VarChar(20)
  reference_number   String?        @unique @db.VarChar(30)
  date_requested     DateTime       @default(now()) @db.Timestamptz(6)
  date_released      DateTime?      @db.Timestamptz(6)
  committees         committees     @relation(fields: [committee_id], references: [committee_id])
  document_types     document_types @relation(fields: [doc_type_id], references: [doc_type_id])
  staff              staff?         @relation(fields: [issued_by_staff_id], references: [staff_id], onDelete: Restrict)
  residents          residents      @relation(fields: [resident_id], references: [resident_id])

  @@index([committee_id], map: "idx_requests_committee")
  @@index([resident_id], map: "idx_requests_resident")
}

model staff {
  staff_id                    Int                           @id @default(autoincrement())
  first_name                  String                        @db.VarChar(60)
  last_name                   String                        @db.VarChar(60)
  position                    String                        @db.VarChar(60)
  date_hired                  DateTime                      @default(dbgenerated("CURRENT_DATE")) @db.Date
  expense_logs                expense_logs[]
  incident_reports            incident_reports[]
  service_requests            service_requests[]
  staff_committee_assignments staff_committee_assignments[]
  users                       users?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model staff_committee_assignments {
  assignment_id Int        @id @default(autoincrement())
  staff_id      Int
  committee_id  Int
  role          String     @default("Member") @db.VarChar(30)
  assigned_date DateTime   @default(dbgenerated("CURRENT_DATE")) @db.Date
  hours_logged  Decimal    @default(0) @db.Decimal(8, 2)
  committees    committees @relation(fields: [committee_id], references: [committee_id])
  staff         staff      @relation(fields: [staff_id], references: [staff_id])

  @@unique([staff_id, committee_id], map: "uq_staff_committee")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model users {
  user_id       Int          @id @default(autoincrement())
  staff_id      Int?         @unique
  resident_id   Int?         @unique
  username      String       @unique @db.VarChar(50)
  password_hash String       @db.VarChar(255)
  role          String       @db.VarChar(20)
  created_at    DateTime     @default(now()) @db.Timestamptz(6)
  audit_logs    audit_logs[]
  residents     residents?   @relation(fields: [resident_id], references: [resident_id], onDelete: Restrict)
  staff         staff?       @relation(fields: [staff_id], references: [staff_id], onDelete: Restrict)
}
